{
  "name": "serverless-wiki",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "tsc": "vue-tsc --noEmit",
    "lint": "eslint . --fix",
    "format": "prettier . --write",
    "db:generate": "drizzle-kit generate",
    "db:seed:sql": "bun scripts/generate-d1-seed.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "@libsql/client": "^0.17.3",
    "@nuxt/scripts": "^1.0.6",
    "@nuxt/ui": "4.7.1",
    "@nuxthub/core": "0.10.7",
    "@nuxtjs/mdc": "0.22.0",
    "@nuxtjs/sitemap": "^8.0.15",
    "bcryptjs": "^3.0.3",
    "cryptmd5": "^0.1.2",
    "diff": "^9.0.0",
    "drizzle-orm": "^0.45.2",
    "nuxt": "^4.4.5",
    "nuxt-auth-utils": "^0.5.29",
    "nuxt-resend": "0.0.2",
    "rehype-external-links": "^3.0.0",
    "remark-breaks": "^4.0.0",
    "seedrandom": "^3.0.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@egoist/tailwindcss-icons": "^1.9.2",
    "@iconify-json/lucide": "^1.2.107",
    "@nuxt/eslint": "1.15.2",
    "@types/bun": "^1.3.14",
    "@types/seedrandom": "^3.0.8",
    "drizzle-kit": "^0.31.10",
    "eslint": "10.3.0",
    "php-serialize": "^5.1.3",
    "prettier": "3.8.3",
    "vue-tsc": "^3.2.9",
    "wrangler": "^4.90.1"
  },
  "overrides": {
    "chokidar": "3.6.0"
  }
}