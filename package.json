{
  "name": "serverless-wiki",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "test": "bun run test:unit && bun run test:integration && bun run test:nuxt",
    "test:unit": "bun test test/*.test.ts",
    "test:integration": "vitest run --config vitest.config.ts",
    "test:nuxt": "vitest run --config vitest.nuxt.config.ts",
    "postinstall": "nuxt prepare",
    "tsc": "vue-tsc --noEmit",
    "lint": "eslint . --fix",
    "format": "prettier . --write",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --persist-to .data/wrangler-migration-check",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@nuxt/scripts": "^1.3.12",
    "@nuxt/ui": "4.12.0",
    "@nuxthub/core": "0.10.10",
    "@nuxtjs/mdc": "0.23.2",
    "@nuxtjs/sitemap": "^8.6.2",
    "bcryptjs": "^3.0.3",
    "cryptmd5": "^0.1.2",
    "diff": "^9.0.0",
    "drizzle-orm": "^0.45.4",
    "nuxt": "^4.6.2",
    "nuxt-auth-utils": "^0.5.32",
    "nuxt-resend": "0.0.2",
    "rehype-external-links": "^3.0.0",
    "remark-breaks": "^4.0.0",
    "seedrandom": "^3.0.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@egoist/tailwindcss-icons": "^1.9.2",
    "@iconify-json/lucide": "^1.2.147",
    "@nuxt/eslint": "1.17.0",
    "@nuxt/test-utils": "^4.3.4",
    "@testing-library/vue": "^8.1.0",
    "@types/bun": "^1.4.3",
    "@types/seedrandom": "^3.0.8",
    "@vue/test-utils": "^2.5.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "10.13.0",
    "happy-dom": "^21.0.4",
    "prettier": "3.9.10",
    "typescript": "~6.0.3",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.3.13",
    "wrangler": "^4.151.3"
  },
  "overrides": {
    "chokidar": "3.6.0"
  }
}
